	sound 100, "$(Sounds)/clothes/plate/plate_5.wav", 100, 3;
	sound 100, "$(Sounds)/clothes/plate/plate_6.wav", 100, 3;
	sound 100, "$(Sounds)/clothes/plate/plate_7.wav", 100, 3;
	sound 100, "$(Sounds)/clothes/plate/plate_8.wav", 100, 3;

// alias configuration file
//
// alias "<name>" { ... };
// sound <use chance>, "<file>", <play chance>, <flags>
//
// <flags> is a bit field in decimal/hexadecimal (0xNNNN) format:
//	bit 0: 1=enabled, 0=disabled
//	bit 1: 1=play with accelerated animation, 0=play only with normal speed animation
// All undefined bits are ignored and are not stored.
//

alias "moving_3" {
	sound 100, "$(Sounds)\special\moving_3\moving_3_1.wav", 100, 3;
	sound 100, "$(Sounds)\special\moving_3\moving_3_2.wav", 100, 3;
	sound 100, "$(Sounds)\special\moving_3\moving_3_3.wav", 100, 3;
	sound 100, "$(Sounds)\special\moving_3\moving_3_4.wav", 100, 3;
	sound 100, "$(Sounds)\special\moving_3\moving_3_5.wav", 100, 3;
}

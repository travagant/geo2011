// alias configuration file
//
// alias "<name>" { ... };
// sound <use chance>, "<file>", <play chance>, <flags>
//
// <flags> is a bit field in decimal/hexadecimal (0xNNNN) format:
//	bit 0: 1=enabled, 0=disabled
//	bit 1: 1=play with accelerated animation, 0=play only with normal speed animation
// All undefined bits are ignored and are not stored.
//

alias "big_creature" {
	sound 100, "$(Sounds)\footsteps\big_creature\footsteps_big_creature_layer_01.wav", 100, 3;
	sound 100, "$(Sounds)\footsteps\big_creature\footsteps_big_creature_layer_02.wav", 100, 3;
	sound 100, "$(Sounds)\footsteps\big_creature\footsteps_big_creature_layer_03.wav", 100, 3;
	sound 100, "$(Sounds)\footsteps\big_creature\footsteps_big_creature_layer_04.wav", 100, 3;
	sound 100, "$(Sounds)\footsteps\big_creature\footsteps_big_creature_layer_05.wav", 100, 3;
	sound 100, "$(Sounds)\footsteps\big_creature\footsteps_big_creature_layer_06.wav", 100, 3;
}

{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "coarena": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Coarena",
      "options": {
        "baseURL": "https://coarena.ai/api/v1",
        "apiKey": "ВСТАВЬ_КЛЮЧ_COARENA"
      },
      "models": {
        "deepseek-v4-1-flash-1017": {
          "name": "DeepSeek V4.1 Flash (Coarena)",
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    },
    "zro": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zro",
      "options": {
        "baseURL": "https://zro.moonmath.ai/v1",
        "apiKey": "ВСТАВЬ_КЛЮЧ_ZRO"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (Zro)",
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    },
    "opencode": {
      "name": "OpenCode Zen",
      "models": {
        "deepseek-v4.1-flash-free": {
          "name": "DeepSeek V4.1 Flash Free (Zen)",
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    }
  },
  "model": "coarena/deepseek-v4-1-flash-1017",
  "compaction": {
    "auto": true,
    "background": false,
    "keep": { "tokens": 8000 },
    "buffer": "20%"
  },
  "tool_output": {
    "max_lines": 600,
    "max_bytes": 16000
  },
  "agents": {
    "build": { "steps": 120 },
    "compaction": { "model": "opencode/deepseek-v4.1-flash-free" }
  }
}
